# Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Strapi Backend API URL
# For development, use: http://localhost:1337
# For production, use your Railway deployment URL
NEXT_PUBLIC_STRAPI_URL=https://ambelie-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=https://ambelie-backend-production.up.railway.app

# SMTP Configuration for Contact Form
# 推荐使用QQ邮箱（更容易配置）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-qq-smtp-password

# 或者使用Gmail（需要应用密码）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password

# Other environment variables can be added here as needed

# --- Tencent Cloud COS (server-side only) ---
# 用于将试衣生成结果上传到对象存储并返回URL
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=ambelie-1368352639
TENCENT_COS_REGION=ap-guangzhou
# 可选：CDN 加速域名（建议使用 https://media.ambelie.com）
TENCENT_COS_CDN_DOMAIN=https://media.ambelie.com
# 可选：在桶内的存储前缀
TRYON_COS_BASE_PATH=tryon-results/

# Tencent Cloud COS/CDN
# COS Bucket/Region are configured server-side in code defaults; override if needed
# Public CDN domain used to serve generated images
TENCENT_COS_CDN_DOMAIN=https://media.ambelie.com

# COS credentials (also used as fallback for CDN signature)
TENCENT_COS_SECRET_ID=YOUR_SECRET_ID
TENCENT_COS_SECRET_KEY=YOUR_SECRET_KEY
TENCENT_COS_BUCKET=ambelie-1368352639
TENCENT_COS_REGION=ap-guangzhou

# Optional: Separate CDN API credentials. If not set, COS credentials are used.
TENCENT_CDN_SECRET_ID=
TENCENT_CDN_SECRET_KEY=

# Gemini API Key（服务器端）
GEMINI_API_KEY=