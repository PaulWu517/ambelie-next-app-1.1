# Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Strapi Backend API URL
# For development, use: http://localhost:1337
# For production, use your Railway deployment URL
NEXT_PUBLIC_STRAPI_URL=https://ambelie-backend-production.up.railway.app
NEXT_PUBLIC_API_URL=https://ambelie-backend-production.up.railway.app

# SMTP Configuration for Contact Form
# 推荐使用QQ邮箱（更容易配置）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-qq-smtp-password

# 或者使用Gmail（需要应用密码）
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-gmail-app-password

# Other environment variables can be added here as needed