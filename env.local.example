# Next.js 前端环境变量示例
# 复制此文件为 .env.local 并填入您的实际值

# Stripe 公钥（可以安全地暴露在前端）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# 后端API地址（两个变量名都需要配置以确保兼容性）
NEXT_PUBLIC_API_URL=https://ambelie-backend-production.up.railway.app
NEXT_PUBLIC_STRAPI_URL=https://ambelie-backend-production.up.railway.app

# 当前网站域名
NEXT_PUBLIC_SITE_URL=https://ambelie-next-app-1-1.vercel.app

# NextAuth 配置
NEXTAUTH_URL=https://ambelie-next-app-1-1.vercel.app
NEXTAUTH_SECRET=your-nextauth-secret-here

# Google OAuth (可选)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Tencent Cloud COS (server-side only) ---
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=ambelie-1368352639
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_CDN_DOMAIN=https://media.ambelie.com
TRYON_COS_BASE_PATH=tryon-results/

# Gemini API Key（服务器端）
GEMINI_API_KEY=